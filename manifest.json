{
  "manifest_version": 3,
  "name": "Crunchyroll Release Calendar (Unofficial)",
  "version": "0.2.2",
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "crunchyroll-release-calendar@spirrwell.github.io",
      "strict_min_version": "128.0"
    }
  },
  "description": "Brings back the weekly release calendar: what actually went live on Crunchyroll, day by day, with sub/dub filters.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://www.crunchyroll.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "calendar_redirect",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": ["calendar.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
